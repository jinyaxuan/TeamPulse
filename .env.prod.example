# Copy to .env.prod and fill in real values. docker-compose reads .env by default;
# use `docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d`.

# Postgres — strong password, not the same as dev!
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=teampulse

# Public URL the web dashboard is served at. Used to build magic links.
PUBLIC_APP_URL=https://teampulse.internal.company.com

# Hostname Caddy will request a TLS cert for.
PUBLIC_HOSTNAME=teampulse.internal.company.com

# Session cookie name (change if you want to avoid collisions with other apps
# on the same host).
SESSION_COOKIE_NAME=teampulse_session
