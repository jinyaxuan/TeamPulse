# TeamPulse reusable Node base image.
#
# Build once per server/runtime family:
#   docker build -f apps/web/Dockerfile.base -t teampulse-node-base:22-bookworm .

ARG NODE_VERSION=22
ARG PNPM_VERSION=10.25.0
ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ARG PNPM_TARBALL_SHA512=XoJjkCevN8+DIGG8xtY5whljRIjg8rrr54UCink957Ul/80/f/V09emGBlTgmP6FK6isXdXO/hdn0joCCpL1AQ==

FROM node:${NODE_VERSION}-bookworm

ARG PNPM_VERSION
ARG NPM_CONFIG_REGISTRY
ARG PNPM_TARBALL_SHA512

ENV NEXT_TELEMETRY_DISABLED=1

RUN set -eux; \
    tarball="/tmp/pnpm-${PNPM_VERSION}.tgz"; \
    curl -fsSL \
      --retry 5 \
      --retry-all-errors \
      --retry-delay 2 \
      --connect-timeout 10 \
      --max-time 120 \
      "${NPM_CONFIG_REGISTRY%/}/pnpm/-/pnpm-${PNPM_VERSION}.tgz" \
      -o "${tarball}"; \
    actual="$(openssl dgst -sha512 -binary "${tarball}" | openssl base64 -A)"; \
    test "${actual}" = "${PNPM_TARBALL_SHA512}"; \
    NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY}" \
      npm install --global "${tarball}" --no-fund --no-audit; \
    rm -f "${tarball}"
